/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://nextflow-telecom.firebaseapp.com; worker-src 'self' blob:; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: no-store

/
  Cache-Control: no-store

/vendor/*
  Cache-Control: public, max-age=86400, must-revalidate
