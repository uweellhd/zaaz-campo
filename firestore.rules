rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function corporateEmail() {
      return signedIn() && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@zaaztelecom\\.com\\.br$');
    }
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function active() {
      return corporateEmail() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && profile().ativo == true;
    }
    function role() {
      return profile().perfil;
    }
    function globalReader() {
      return role() in ['admin', 'noc', 'gerente', 'diretor', 'sac', 'suporte'];
    }
    function validForecast(value) {
      return value is string && value.matches('^(20[2-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function teamMember(uid, supervisorUid) {
      let person = get(/databases/$(database)/documents/usuarios/$(uid)).data;
      let team = get(/databases/$(database)/documents/equipesTecnicas/$(uid)).data;
      return person.ativo == true && person.perfil == 'tecnico' && team.ativo == true && team.supervisorUid == supervisorUid;
    }
    function assignTechnician() {
      let supervisorUid = resource.data.get('supervisorUid', '');
      let uid = request.resource.data.tecnicoUid;
      return stage(resource.data) < 4 && !resource.data.get('statusAtual','').matches('.*(FINALIZADO|FINALIZADA|RESOLVIDO|CONCLUÍDO).*')
        && supervisorUid != '' && teamMember(uid, supervisorUid)
        && request.resource.data.tecnicoAtribuido == get(/databases/$(database)/documents/usuarios/$(uid)).data.nome;
    }

    function nocUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['idIncidente','os','cidades','estado','tipoRede','olt','portas','incidenteTipo','clientesCount','responsavel','previsao','statusAtual','descricao','textoCompleto','ixcUsuarioId','supervisorUid','supervisorNome','supervisorVinculoOrigem','tecnicoUid','tecnicoAtribuido'])
        && (data.get('tecnicoUid','') == resource.data.get('tecnicoUid','') && data.get('tecnicoAtribuido','') == resource.data.get('tecnicoAtribuido','')
          || (data.get('supervisorUid','') != resource.data.get('supervisorUid','') && data.get('tecnicoUid','') == '' && data.get('tecnicoAtribuido','') == ''))
        && (!changed.hasAny(['supervisorUid']) || data.supervisorUid == '' || (
          get(/databases/$(database)/documents/usuarios/$(data.supervisorUid)).data.perfil == 'supervisor'
          && get(/databases/$(database)/documents/usuarios/$(data.supervisorUid)).data.ativo == true
          && data.supervisorNome == get(/databases/$(database)/documents/usuarios/$(data.supervisorUid)).data.nome));
    }

    // A etapa enviada fica imutável; nova etapa é sempre a próxima da sequência.
    function legacyStage(data) {
      let events = data.get('timelineEtapas', []);
      let last = events.size() > 0 ? events[events.size() - 1].get('etapa', '') : '';
      return last.matches('^ETAPA 4.*') ? 4 : last.matches('^ETAPA 3.*') ? 3 : last.matches('^ETAPA 2.*') ? 2 : last.matches('^ETAPA 1.*') ? 1 : 0;
    }
    function stage(data) {
      return 'etapaConcluida' in data ? data.etapaConcluida : legacyStage(data);
    }
    function text(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }
    function photoEvidence(event, photoIndex, incidentId) {
      let photo = get(/databases/$(database)/documents/fotos/$(event.fotoIds[photoIndex])).data;
      return photo.incidenteId == incidentId && photo.criadoPorUid == request.auth.uid
        && photo.get('numeroEtapa', 0) == event.numeroEtapa
        && photo.criadoEm > request.time - duration.value(15, 'd');
    }
    function photoGroup(event, name, incidentId) {
      let group = event.gruposFotos[name];
      return group.indiceFoto is int && group.indiceFoto >= 0
        && group.quantidadeFotos is int && group.quantidadeFotos >= 1 && group.quantidadeFotos <= 6
        && group.indiceFoto + group.quantidadeFotos <= event.fotoIds.size()
        && photoEvidence(event, group.indiceFoto, incidentId);
    }
    function boxFields(box, photoCount) {
      return box.gps.matches('^-?[0-9]+([.][0-9]+)?,[ ]*-?[0-9]+([.][0-9]+)?$')
        && box.quantidadeFotos in [1, 2, 3, 4, 5, 6]
        && box.indiceFoto is int && box.indiceFoto >= 0
        && box.indiceFoto + box.quantidadeFotos <= photoCount;
    }
    function boxValid(boxes, index, photoCount) {
      return index >= boxes.size() ? true : boxFields(boxes[index], photoCount);
    }
    // As primeiras quatro caixas são validadas no incidente e as demais na entrega.
    // A transação vincula os dois documentos e respeita o orçamento das regras.
    function firstBoxes(boxes, photoCount) {
      return boxes is list && boxes.size() >= 2 && boxes.size() <= 12
        && boxValid(boxes, 0, photoCount) && boxValid(boxes, 1, photoCount)
        && boxValid(boxes, 2, photoCount) && boxValid(boxes, 3, photoCount);
    }
    function remainingBoxes(boxes, photoCount) {
      return boxes is list && boxes.size() >= 2 && boxes.size() <= 12 && photoCount >= boxes.size()
        && boxValid(boxes, 4, photoCount) && boxValid(boxes, 5, photoCount)
        && boxValid(boxes, 6, photoCount) && boxValid(boxes, 7, photoCount)
        && boxValid(boxes, 8, photoCount) && boxValid(boxes, 9, photoCount)
        && boxValid(boxes, 10, photoCount) && boxValid(boxes, 11, photoCount);
    }
    function finalRecord(record) {
      return record is map && record.keys().hasOnly(['causa', 'solucao', 'observacao'])
        && text(record.causa, 5000) && text(record.solucao, 5000) && text(record.observacao, 5000);
    }
    function finalDelivery(event, incidentId) {
      let delivery = getAfter(/databases/$(database)/documents/projetosEvidencias/$(incidentId)).data;
      return delivery.caixas == event.caixas && delivery.fotoIds == event.fotoIds && delivery.registroFinal == event.registroFinal;
    }
    function validStage(event, incidentId) {
      return event.numeroEtapa == 1 ? ( event.tipoArea in ['URBANA', 'RURAL'] && event.condicaoRisco in ['NAO_INFORMADO', 'COMUNIDADE', 'OUTRO']
        && photoGroup(event, 'fotoDeslocamento', incidentId)
        && event.gruposFotos.fotoDeslocamento.indiceFoto == 0
        && event.fotoIds.size() == event.gruposFotos.fotoDeslocamento.quantidadeFotos)
      : event.numeroEtapa == 2 ? ( text(event.causaRompimento, 1000) && validForecast(event.previsaoInformada)
        && event.gpsRompimento is string && event.gpsRompimento.matches('^-?([0-8]?[0-9]([.][0-9]+)?|90([.]0+)?),[ ]*-?(1[0-7][0-9]([.][0-9]+)?|[0-9]{1,2}([.][0-9]+)?|180([.]0+)?)$')
        && event.localizacaoRompimento.latitude is number && event.localizacaoRompimento.longitude is number
        && event.localizacaoRompimento.latitude >= -90 && event.localizacaoRompimento.latitude <= 90
        && event.localizacaoRompimento.longitude >= -180 && event.localizacaoRompimento.longitude <= 180
        && request.resource.data.previsao == event.previsaoInformada
        && photoGroup(event, 'fotoChegada', incidentId) && photoGroup(event, 'fotoRompimento', incidentId)
        && event.gruposFotos.fotoChegada.indiceFoto == 0
        && event.gruposFotos.fotoRompimento.indiceFoto == event.gruposFotos.fotoChegada.quantidadeFotos
        && event.fotoIds.size() == event.gruposFotos.fotoChegada.quantidadeFotos + event.gruposFotos.fotoRompimento.quantidadeFotos)
      : event.numeroEtapa == 3 ? ( text(event.observacaoAtuacao, 1500)
        && (event.previsaoRevisada == '' ? request.resource.data.get('previsao', '') == resource.data.get('previsao', '')
          : validForecast(event.previsaoRevisada) && text(event.motivoRevisao, 1000)
            && event.previsaoAnterior == resource.data.get('previsao', 'A definir')
            && request.resource.data.previsao == event.previsaoRevisada)
        && photoGroup(event, 'fotoPanoramica', incidentId) && photoGroup(event, 'fotoEquipe', incidentId)
        && event.gruposFotos.fotoPanoramica.indiceFoto == 0
        && event.gruposFotos.fotoEquipe.indiceFoto == event.gruposFotos.fotoPanoramica.quantidadeFotos
        && event.fotoIds.size() == event.gruposFotos.fotoPanoramica.quantidadeFotos + event.gruposFotos.fotoEquipe.quantidadeFotos)
      : (event.numeroEtapa == 4 && firstBoxes(event.caixas, event.fotoIds.size())
        && text(event.descricaoServico, 5000) && finalRecord(event.registroFinal)
        && event.descricaoServico == 'CAUSA: ' + event.registroFinal.causa + '\n\nSOLUÇÃO: ' + event.registroFinal.solucao + '\n\nOBSERVAÇÃO: ' + event.registroFinal.observacao
        && photoEvidence(event, 0, incidentId) && photoEvidence(event, event.caixas[1].indiceFoto, incidentId)
        && finalDelivery(event, incidentId));
    }
    function sequentialUpdate(incidentId) {
      let previousStage = stage(resource.data);
      let previous = resource.data.get('timelineEtapas', []);
      let events = request.resource.data.timelineEtapas;
      let event = events[events.size() - 1];
      return previousStage < 4 && events.size() == previous.size() + 1
        && events.removeAll([event]) == previous
        && request.resource.data.fluxoVersao == 2 && request.resource.data.etapaConcluida == previousStage + 1
        && event.numeroEtapa == request.resource.data.etapaConcluida && event.fluxoVersao == 2
        && event.tecnicoUid == request.auth.uid && event.tecnico == profile().nome
        && event.fotosPendentes == 0 && event.fotoIds is list && event.fotoIds.size() >= 1 && event.fotoIds.size() <= 72
        && event.fotoIds.toSet().size() == event.fotoIds.size()
        && event.etapa == request.resource.data.statusAtual
        && ((event.numeroEtapa == 1 && event.etapa == 'ETAPA 1: EM DESLOCAMENTO')
          || (event.numeroEtapa == 2 && event.etapa == 'ETAPA 2: NO LOCAL / ROMPIMENTO')
          || (event.numeroEtapa == 3 && event.etapa == 'ETAPA 3: EXECUTANDO / FUSIONANDO')
          || (event.numeroEtapa == 4 && event.etapa == 'ETAPA 4: REPARO CONCLUÍDO / FINALIZADO'))
        && validStage(event, incidentId);
    }

    function createDelivery(incidentId) {
      let data = request.resource.data;
      let incident = get(/databases/$(database)/documents/incidentes/$(incidentId)).data;
      let person = profile();
      return person.perfil in ['admin', 'tecnico']
        && data.keys().hasOnly(['incidenteId', 'idIncidente', 'os', 'estado', 'criadoPorUid', 'criadoEm', 'caixas', 'descricaoServico', 'fotoIds', 'statusOzmaps', 'fluxoVersao', 'registroFinal'])
        && data.incidenteId == incidentId && data.criadoPorUid == request.auth.uid && data.criadoEm == request.time
        && data.statusOzmaps == 'PENDENTE' && data.fluxoVersao == 2
        && data.fotoIds is list && data.fotoIds.size() <= 72
        && remainingBoxes(data.caixas, data.fotoIds.size())
        && text(data.descricaoServico, 5000) && finalRecord(data.registroFinal)
        && data.estado == incident.estado && data.idIncidente == incident.idIncidente
        && (person.perfil == 'admin' || (incident.tecnicoUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/incidentes/$(incidentId)).data.fluxoVersao == 2
          && stage(getAfter(/databases/$(database)/documents/incidentes/$(incidentId)).data) == 4));
    }

    match /usuarios/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid)
        || (active() && role() == 'tecnico' && resource.data.perfil == 'supervisor'
          && get(/databases/$(database)/documents/equipesTecnicas/$(request.auth.uid)).data.supervisorUid == uid)
        || (active() && (role() == 'admin' || (role() in ['noc','supervisor'] && resource.data.perfil in ['tecnico', 'supervisor'])
          || (role() == 'tecnico' && resource.data.perfil == 'tecnico')));
      allow list: if active() && (role() == 'admin' || (role() in ['noc','supervisor'] && resource.data.perfil in ['tecnico', 'supervisor'])
        || (role() == 'tecnico' && resource.data.perfil == 'tecnico'));
      allow create: if active() && role() == 'admin' && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['ativo', 'estado', 'nome', 'perfil'])
        && request.resource.data.ativo == true
        && (request.resource.data.estado == 'TODOS' || request.resource.data.estado.matches('^[A-Z]{2}$'))
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 120
        && request.resource.data.perfil in ['noc', 'sac', 'suporte', 'tecnico', 'gerente', 'diretor', 'supervisor', 'projetos']

        && exists(/databases/$(database)/documents/solicitacoesAcesso/$(uid))
        && get(/databases/$(database)/documents/solicitacoesAcesso/$(uid)).data.status == 'pendente';
      allow update: if active() && role() == 'admin' && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'estado', 'nome', 'perfil'])
        && request.resource.data.ativo is bool
        && (request.resource.data.estado == 'TODOS' || request.resource.data.estado.matches('^[A-Z]{2}$'))
        && request.resource.data.perfil in ['noc', 'sac', 'suporte', 'tecnico', 'gerente', 'diretor', 'supervisor', 'projetos']
;
      allow delete: if false;
    }

    match /equipesTecnicas/{uid} {
      allow get: if active() && (role() in ['admin','noc','supervisor'] || (role() == 'tecnico' && (uid == request.auth.uid || resource.data.supervisorUid == get(/databases/$(database)/documents/equipesTecnicas/$(request.auth.uid)).data.supervisorUid)));
      allow list: if active() && (role() in ['admin','noc','supervisor'] || (role() == 'tecnico' && resource.data.supervisorUid == get(/databases/$(database)/documents/equipesTecnicas/$(request.auth.uid)).data.supervisorUid));
      allow create, update: if active() && role() in ['admin','supervisor']
        && request.resource.data.keys().hasOnly(['tecnicoUid','supervisorUid','ativo','atualizadoEm','atualizadoPorUid'])
        && request.resource.data.tecnicoUid == uid && request.resource.data.ativo is bool
        && request.resource.data.atualizadoEm == request.time && request.resource.data.atualizadoPorUid == request.auth.uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.perfil == 'tecnico'
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.ativo == true
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.supervisorUid)).data.perfil == 'supervisor'
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.supervisorUid)).data.ativo == true
        && (role() == 'admin' || (request.resource.data.supervisorUid == request.auth.uid
          && (!exists(/databases/$(database)/documents/equipesTecnicas/$(uid)) || resource.data.supervisorUid == request.auth.uid)));
      allow delete: if false;
    }
    match /identidadesIxc/{ixcId} {
      allow get: if active() && role() in ['admin','noc'];
      allow list: if active() && role() == 'admin';
      allow create, update: if active() && role() == 'admin' && ixcId.matches('^[0-9]{1,20}$')
        && request.resource.data.keys().hasOnly(['supervisorUid','supervisorNome','atualizadoEm','atualizadoPorUid'])
        && request.resource.data.atualizadoEm == request.time && request.resource.data.atualizadoPorUid == request.auth.uid
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.supervisorUid)).data.perfil == 'supervisor'
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.supervisorUid)).data.ativo == true
        && request.resource.data.supervisorNome == get(/databases/$(database)/documents/usuarios/$(request.resource.data.supervisorUid)).data.nome;
      allow delete: if active() && role() == 'admin';
    }

    match /solicitacoesAcesso/{uid} {
      allow get: if (corporateEmail() && request.auth.uid == uid) || (active() && role() == 'admin');
      allow list: if active() && role() == 'admin';
      allow create: if corporateEmail() && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'status', 'criadoEm'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3
        && request.resource.data.nome.size() <= 120
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time;
      allow update: if active() && role() == 'admin'
        && resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revisadoEm', 'revisadoPor'])
        && request.resource.data.status in ['aprovado', 'rejeitado']
        && request.resource.data.revisadoPor == request.auth.uid
        && request.resource.data.revisadoEm == request.time;
      allow delete: if false;
    }

    match /incidentes/{incidentId} {
      // O técnico só consulta os documentos cujo técnicoUid é o próprio UID.
      allow read: if active() && (globalReader() ||
        (role() == 'tecnico' && resource.data.get('tecnicoUid', '') == request.auth.uid) ||
        (role() == 'supervisor' && resource.data.get('supervisorUid', '') == request.auth.uid));
      allow create: if active() && role() in ['admin', 'noc']
        && request.resource.data.estado.matches('^[A-Z]{2}$')
        && (role() == 'admin' || (request.resource.data.get('tecnicoUid','') == '' && request.resource.data.get('tecnicoAtribuido','') == '' && request.resource.data.get('timelineEtapas',[]) == [] && request.resource.data.get('etapaConcluida',0) == 0));
      allow delete: if active() && role() == 'admin';
      allow update: if active() && (
        role() == 'admin' || (role() == 'noc' && nocUpdate()) ||
        (role() == 'tecnico'
          && resource.data.get('tecnicoUid', '') == request.auth.uid
          && request.resource.data.tecnicoUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusAtual', 'timelineEtapas', 'previsao', 'etapaConcluida', 'fluxoVersao'
          ]) && sequentialUpdate(incidentId)
        ) || (role() in ['tecnico','supervisor']
          && (role() == 'supervisor' ? resource.data.get('supervisorUid','') == request.auth.uid : resource.data.get('tecnicoUid','') == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tecnicoUid','tecnicoAtribuido','atribuidoEm','atribuidoPorUid','atribuidoPorNome'])
          && assignTechnician()
          && (role() == 'tecnico' || (request.resource.data.atribuidoEm == request.time
            && request.resource.data.atribuidoPorUid == request.auth.uid && request.resource.data.atribuidoPorNome == profile().nome))
        )
      );
    }

    match /fotos/{photoId} {
      allow get: if active()
        && resource.data.criadoEm > request.time - duration.value(15, 'd')
        && (globalReader() || (role() == 'projetos'
          && exists(/databases/$(database)/documents/projetosEvidencias/$(resource.data.incidenteId))
          && photoId in get(/databases/$(database)/documents/projetosEvidencias/$(resource.data.incidenteId)).data.fotoIds)
          || (role() == 'tecnico'
          && get(/databases/$(database)/documents/incidentes/$(resource.data.incidenteId)).data.get('tecnicoUid', '') == request.auth.uid)
          || (role() == 'supervisor'
          && get(/databases/$(database)/documents/incidentes/$(resource.data.incidenteId)).data.get('supervisorUid', '') == request.auth.uid));
      allow list: if false;
      allow create: if active() && role() in ['admin', 'tecnico']
        && request.resource.data.keys().hasOnly(['incidenteId', 'estado', 'criadoPorUid', 'criadoEm', 'dadosBase64', 'numeroEtapa'])
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.dadosBase64 is string
        && request.resource.data.dadosBase64.size() <= 700000
        && request.resource.data.numeroEtapa in [1, 2, 3, 4]
        && request.resource.data.dadosBase64.matches('^data:image/jpeg;base64,.*')
        && exists(/databases/$(database)/documents/incidentes/$(request.resource.data.incidenteId))
        && request.resource.data.estado == get(/databases/$(database)/documents/incidentes/$(request.resource.data.incidenteId)).data.estado
        && (role() == 'admin' || ( get(/databases/$(database)/documents/incidentes/$(request.resource.data.incidenteId)).data.tecnicoUid == request.auth.uid
          && request.resource.data.numeroEtapa == stage(get(/databases/$(database)/documents/incidentes/$(request.resource.data.incidenteId)).data) + 1));
      // Somente a rotina agendada no servidor apaga fotos. O Admin SDK ignora estas regras.
      allow update, delete: if false;
    }

    match /projetosEvidencias/{incidentId} {
      allow read: if active() && role() in ['admin', 'projetos'];
      allow create: if active() && createDelivery(incidentId);
      allow update: if active() && role() in ['admin', 'projetos']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusOzmaps', 'observacaoOzmaps', 'tratadoPorUid', 'tratadoPorNome', 'tratadoEm'])
        && request.resource.data.statusOzmaps == 'REGISTRADO'
        && request.resource.data.tratadoPorUid == request.auth.uid
        && request.resource.data.tratadoPorNome == profile().nome
        && request.resource.data.tratadoEm == request.time
        && request.resource.data.observacaoOzmaps is string
        && request.resource.data.observacaoOzmaps.size() <= 2000;
      allow delete: if false;
    }

    // Medições OTDR: serviço independente. Nenhuma permissão é herdada dos rompimentos.
    function measurementReader(data) {
      return active() && (role() in ['admin','diretor','gerente']
        || (role() == 'tecnico' && data.tecnicoUid == request.auth.uid)
        || (role() == 'supervisor' && data.supervisorUid == request.auth.uid)
        || (role() == 'projetos' && data.status in ['ENTREGUE','CONFERIDA']));
    }
    function measurementOwner(id) {
      let data = get(/databases/$(database)/documents/medicoes/$(id)).data;
      return active() && data.status == 'EM_CAMPO'
        && (role() == 'admin' || (role() == 'tecnico' && data.tecnicoUid == request.auth.uid));
    }
    function measurementGPS(g) {
      return g is map && g.keys().hasOnly(['latitude','longitude','precisao'])
        && g.latitude is number && g.latitude >= -90 && g.latitude <= 90
        && g.longitude is number && g.longitude >= -180 && g.longitude <= 180
        && g.precisao is number && g.precisao >= 0;
    }
    function measurementCreate() {
      let d = request.resource.data;
      let supervisor = get(/databases/$(database)/documents/usuarios/$(d.supervisorUid)).data;
      return d.keys().hasOnly(['referencia','cidade','pontoA','pontoB','fibras','estado','tecnicoUid','tecnicoNome','supervisorUid','supervisorNome','status','criadoPorUid','criadoEm','versao'])
        && d.versao == 1 && d.status == 'AGUARDANDO_TECNICO' && d.criadoPorUid == request.auth.uid && d.criadoEm == request.time
        && text(d.referencia,100) && text(d.cidade,120) && text(d.pontoA,200) && text(d.pontoB,200)
        && d.fibras is string && d.fibras.size() <= 300 && d.tecnicoUid == '' && d.tecnicoNome == ''
        && d.estado in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
        && supervisor.ativo == true && supervisor.perfil == 'supervisor' && d.supervisorNome == supervisor.nome
        && (role() == 'admin' || (role() == 'supervisor' && d.supervisorUid == request.auth.uid));
    }
    function measurementAssignment() {
      let d = request.resource.data;
      let person = get(/databases/$(database)/documents/usuarios/$(d.tecnicoUid)).data;
      return resource.data.status == 'AGUARDANDO_TECNICO' && d.status == 'EM_CAMPO'
        && (role() == 'admin' || (role() == 'supervisor' && resource.data.supervisorUid == request.auth.uid))
        && d.diff(resource.data).affectedKeys().hasOnly(['status','tecnicoUid','tecnicoNome','atribuidoEm','atribuidoPorUid','atribuidoPorNome'])
        && teamMember(d.tecnicoUid,resource.data.supervisorUid) && d.tecnicoNome == person.nome
        && d.atribuidoEm == request.time && d.atribuidoPorUid == request.auth.uid && d.atribuidoPorNome == profile().nome;
    }
    function measurementProof(id, key, count) {
      let proof = get(/databases/$(database)/documents/medicoes/$(id)/comprovantes/$(key)).data;
      return proof.quantidade == count && proof.criadoEm > request.time - duration.value(14,'d');
    }
    function measurementDelivery(id) {
      let d = request.resource.data;
      return measurementOwner(id)
        && d.diff(resource.data).affectedKeys().hasOnly(['status','entregueEm','entreguePorUid','observacao','txGps','rxGps','txFotos','rxFotos','txArquivos','rxArquivos','fibras'])
        && d.status == 'ENTREGUE' && d.entreguePorUid == request.auth.uid && d.entregueEm == request.time
        && text(d.observacao,3000) && d.get('fibras','') is string && d.get('fibras','').size() <= 300 && measurementGPS(d.txGps) && measurementGPS(d.rxGps)
        && measurementProof(id,'txFotos',d.txFotos) && measurementProof(id,'rxFotos',d.rxFotos)
        && measurementProof(id,'txArquivos',d.txArquivos) && measurementProof(id,'rxArquivos',d.rxArquivos);
    }
    function proofPhoto(id, side, index, count) {
      let photoId = id + '-' + side + '-' + string(index);
      return index >= count || (get(/databases/$(database)/documents/medicoesFotos/$(photoId)).data.medicaoId == id
        && get(/databases/$(database)/documents/medicoesFotos/$(photoId)).data.criadoEm > request.time - duration.value(1,'d'));
    }
    function proofFile(id, side, index, count) {
      let fileId = side + '-' + string(index);
      return index >= count || get(/databases/$(database)/documents/medicoes/$(id)/arquivos/$(fileId)).data.completo == true;
    }
    function validMeasurementProof(id, key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo','lado','quantidade','criadoPorUid','criadoEm'])
        && d.criadoPorUid == request.auth.uid && d.criadoEm == request.time && d.lado in ['tx','rx'] && d.quantidade is int && d.quantidade >= 1
        && ((d.tipo == 'fotos' && key == d.lado + 'Fotos' && d.quantidade <= 6
          && proofPhoto(id,d.lado,0,d.quantidade) && proofPhoto(id,d.lado,1,d.quantidade)
          && proofPhoto(id,d.lado,2,d.quantidade) && proofPhoto(id,d.lado,3,d.quantidade)
          && proofPhoto(id,d.lado,4,d.quantidade) && proofPhoto(id,d.lado,5,d.quantidade))
          || (d.tipo == 'arquivos' && key == d.lado + 'Arquivos' && d.quantidade <= 3
          && proofFile(id,d.lado,0,d.quantidade) && proofFile(id,d.lado,1,d.quantidade) && proofFile(id,d.lado,2,d.quantidade)));
    }
    function measurementChunk(id, file, n, count) {
      return n >= count || exists(/databases/$(database)/documents/medicoes/$(id)/arquivos/$(file)/partes/$(string(n)));
    }
    function measurementPartLength(file, partId) {
      let length = int(partId) == file.partes - 1 ? file.tamanho - (file.partes - 1) * 524288 : 524288;
      return int((length + 2) / 3) * 4;
    }
    match /medicoes/{measurementId} {
      allow read: if measurementReader(resource.data);
      allow create: if active() && role() in ['admin','supervisor'] && measurementCreate();
      allow update: if active() && (measurementAssignment() || measurementDelivery(measurementId)
        || (role() in ['admin','projetos'] && resource.data.status == 'ENTREGUE' && request.resource.data.status == 'CONFERIDA'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','observacaoProjetos','conferidoPorUid','conferidoPorNome','conferidoEm'])
          && text(request.resource.data.observacaoProjetos,2000) && request.resource.data.conferidoPorUid == request.auth.uid
          && request.resource.data.conferidoPorNome == profile().nome && request.resource.data.conferidoEm == request.time));
      allow delete: if false;
      match /comprovantes/{key} {
        allow read: if measurementReader(get(/databases/$(database)/documents/medicoes/$(measurementId)).data);
        allow create: if measurementOwner(measurementId) && validMeasurementProof(measurementId,key);
        allow update, delete: if false;
      }
      match /arquivos/{fileId} {
        allow read: if measurementReader(get(/databases/$(database)/documents/medicoes/$(measurementId)).data);
        allow create: if measurementOwner(measurementId)
          && request.resource.data.keys().hasOnly(['nome','tamanho','sha256','lado','indice','partes','completo','criadoPorUid','criadoEm'])
          && request.resource.data.lado in ['tx','rx'] && request.resource.data.indice in [0,1,2]
          && fileId == request.resource.data.lado + '-' + string(request.resource.data.indice)
          && text(request.resource.data.nome,180) && request.resource.data.nome.lower().matches('^.+[.](sor|msor|trc|iolm)$')
          && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 2097152
          && request.resource.data.partes in [1,2,3,4]
          && request.resource.data.tamanho > (request.resource.data.partes - 1) * 524288 && request.resource.data.tamanho <= request.resource.data.partes * 524288
          && request.resource.data.sha256.matches('^[a-f0-9]{64}$') && request.resource.data.completo == false
          && request.resource.data.criadoPorUid == request.auth.uid && request.resource.data.criadoEm == request.time;
        allow update: if measurementOwner(measurementId) && resource.data.completo == false && request.resource.data.completo == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completo'])
          && measurementChunk(measurementId,fileId,0,resource.data.partes) && measurementChunk(measurementId,fileId,1,resource.data.partes)
          && measurementChunk(measurementId,fileId,2,resource.data.partes) && measurementChunk(measurementId,fileId,3,resource.data.partes);
        allow delete: if false;
        match /partes/{partId} {
          allow read: if measurementReader(get(/databases/$(database)/documents/medicoes/$(measurementId)).data);
          allow create: if measurementOwner(measurementId)
            && get(/databases/$(database)/documents/medicoes/$(measurementId)/arquivos/$(fileId)).data.completo == false
            && partId in ['0','1','2','3'] && int(partId) < get(/databases/$(database)/documents/medicoes/$(measurementId)/arquivos/$(fileId)).data.partes
            && request.resource.data.keys().hasOnly(['dados']) && text(request.resource.data.dados,699052)
            && request.resource.data.dados.size() == measurementPartLength(get(/databases/$(database)/documents/medicoes/$(measurementId)/arquivos/$(fileId)).data,partId)
            && request.resource.data.dados.matches('^[A-Za-z0-9+/]+={0,2}$');
          allow update, delete: if false;
        }
      }
    }
    match /medicoesFotos/{photoId} {
      allow get: if (active() && role() in ['admin','tecnico'] && !exists(/databases/$(database)/documents/medicoesFotos/$(photoId))) || resource.data.criadoEm > request.time - duration.value(15,'d')
        && measurementReader(get(/databases/$(database)/documents/medicoes/$(resource.data.medicaoId)).data);
      allow list: if false;
      allow create: if measurementOwner(request.resource.data.medicaoId)
        && request.resource.data.keys().hasOnly(['medicaoId','lado','indice','criadoPorUid','criadoEm','dadosBase64'])
        && request.resource.data.lado in ['tx','rx'] && request.resource.data.indice in [0,1,2,3,4,5]
        && photoId == request.resource.data.medicaoId + '-' + request.resource.data.lado + '-' + string(request.resource.data.indice)
        && request.resource.data.criadoPorUid == request.auth.uid && request.resource.data.criadoEm == request.time
        && text(request.resource.data.dadosBase64,700000) && request.resource.data.dadosBase64.matches('^data:image/jpeg;base64,.*');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
